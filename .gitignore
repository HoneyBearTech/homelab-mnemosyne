# Settings and secrets for one installation; only the *.example templates are committed
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc

# Service data and media never belong in the repo, even if a path setting points inside the checkout
appdata/
data/
media/
downloads/
# Docker secret files (passwords, the Discord webhook), should a copy end up in the checkout
secrets/

# Dumps written by scripts/backup.sh: they hold every tenant's database and the roles' password hashes
backups/

# Release and CI outputs (generated by the workflows, never committed)
compose.json
sbom.cdx.json
SHA256SUMS*
*.tar.gz
trivy.sarif

# Keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# The old in-repo vault path; project notes live in Chronos, never here
.obsidian-docs/

# Python tooling for scripts/ and tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
