# Settings for one homelab-mnemosyne installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. The passwords and the Discord webhook are files under CONFIG_ROOT, which
# `scripts/db.sh init` creates.

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group every service runs as, and that owns their folders under CONFIG_ROOT (id -u, id -g).
PUID=1000
PGID=1000

# Host directory holding every service's data, one folder per service: CONFIG_ROOT/postgres/config (the cluster),
# CONFIG_ROOT/mariadb/config, CONFIG_ROOT/diun/config, and beside each the secrets (and PostgreSQL's TLS pair) that
# `scripts/db.sh init` writes. Put it on the VM's data disk (docs/installing.md#the-vm), never inside
# /var/lib/docker/volumes: `docker volume prune` would delete it (docs/installing.md#where-data-lives).
CONFIG_ROOT=/srv/config

# The address range the apps connect from (the hosts that run them), in CIDR form. PostgreSQL's pg_hba.conf admits
# app logins from here only, and scripts/db.sh creates MariaDB users for this range only.
DB_CLIENT_SUBNET=192.0.2.0/24

# This stack's own Docker network, fixed so pg_hba.conf and MariaDB's exporter user can name it. Any private range
# that no other network on the host or the LAN uses.
STACK_SUBNET=172.30.0.0/24

# Published ports.
PG_PORT=5432
MARIADB_PORT=3306
PG_EXPORTER_PORT=9187
MYSQLD_EXPORTER_PORT=9104

# PostgreSQL sizing, for a VM with 8 GB of memory (docs/installing.md#sizing). max_connections covers every app's
# connection pool together: the *arr apps each keep a few per database, Seerr up to 10.
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=5GB
PG_WORK_MEM=8MB
# The container's /dev/shm, which parallel queries use; Docker's default (64 MB) is too small.
PG_SHM_SIZE=512m

# MariaDB sizing.
MARIADB_BUFFER_POOL_SIZE=512M
MARIADB_MAX_CONNECTIONS=200

# When Diun checks the registries for new engine releases (cron, in TZ): every six hours.
DIUN_SCHEDULE="0 */6 * * *"
