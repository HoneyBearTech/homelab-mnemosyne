{
  "name": "mnemosyne",
  "services": {
    "no-image": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "build": {"context": "."}, "healthcheck": {"test": ["CMD", "true"]}},
    "tag-only": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/bazarr:1.5.3", "healthcheck": {"test": ["CMD", "true"]}},
    "latest": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "containrrr/watchtower:latest@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["CMD", "true"]}},
    "digest-only": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/lidarr@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["CMD", "true"]}},
    "short-digest": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/sabnzbd:4.5.3@sha256:abc", "healthcheck": {"test": ["CMD", "true"]}},
    "privileged": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "privileged": true, "healthcheck": {"test": ["CMD", "true"]}},
    "caps": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "cap_add": ["NET_ADMIN", "SYS_ADMIN"], "healthcheck": {"test": ["CMD", "true"]}},
    "hostnet": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "network_mode": "host", "healthcheck": {"test": ["CMD", "true"]}},
    "hostpid": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "pid": "host", "healthcheck": {"test": ["CMD", "true"]}},
    "devices": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "ghcr.io/haveagitgat/tdarr:2.86.01@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "devices": [{"source": "/dev/dri", "target": "/dev/dri", "permissions": "rwm"}, "/dev/fuse:/dev/fuse"], "healthcheck": {"test": ["CMD", "true"]}},
    "socket": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "portainer/agent:2.33.2@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "volumes": [{"type": "bind", "source": "/var/run/docker.sock", "target": "/var/run/docker.sock"}], "healthcheck": {"test": ["CMD", "true"]}},
    "no-healthcheck": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    "healthcheck-disabled": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"disable": true}},
    "healthcheck-none": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["NONE"]}},
    "healthcheck-timing-only": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"interval": "5s"}},
    "unhardened": {"image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["CMD", "true"]}},
    "new-privileges": {"security_opt": ["no-new-privileges:false"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["CMD", "true"]}},
    "partial-drop": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["NET_RAW"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "healthcheck": {"test": ["CMD", "true"]}},
    "caps-all": {"security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "cap_add": ["ALL"], "healthcheck": {"test": ["CMD", "true"]}}
  }
}
